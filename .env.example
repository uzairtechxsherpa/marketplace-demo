PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
MARKETPLACE_MODE=mock

# Locked public hostname so Partner Center URLs do not change on restart.
# Create one free static domain at https://dashboard.ngrok.com/domains then:
# TUNNEL_DOMAIN=your-name.ngrok-free.app
# PUBLIC_BASE_URL=https://your-name.ngrok-free.app

# Shown in Partner Center listing metadata
PRODUCT_NAME=Aether
MARKETPLACE_OFFER_ID=aether-saas-dev

# Publisher Entra app — backend only, calls marketplaceapi.microsoft.com
MARKETPLACE_TENANT_ID=
MARKETPLACE_CLIENT_ID=
MARKETPLACE_CLIENT_SECRET=

# Buyer Entra app — landing-page Microsoft sign-in (any org + personal accounts)
MARKETPLACE_LANDING_CLIENT_ID=
MARKETPLACE_LANDING_CLIENT_SECRET=
MARKETPLACE_LANDING_REDIRECT_URI=http://localhost:4000/api/marketplace/auth/callback

# Day-to-day Microsoft sign-in (same buyer app, second redirect URI)
AUTH_MICROSOFT_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback
